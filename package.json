{
  "name": "estudiantes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "edu": "node ./scripts/edu-score.mjs --full",
    "edu:lint": "eslint . --max-warnings 0",
    "edu:review": "node ./scripts/edu-score.mjs --quick",
    "edu:score": "node ./scripts/edu-score.mjs --full",
    "edu:score:full": "node ./scripts/edu-score.mjs --full --history",
    "edu:grill": "node ./scripts/edu-score.mjs --full && echo \"grill: ver docs/grill-report.template.md y .crisol/grill/\"",
    "lint": "eslint . --max-warnings 0",
    "prepare": "lefthook install || true"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@types/node": "^20.14.0",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.1.0",
    "eslint-plugin-security": "^3.0.1",
    "lefthook": "^1.11.0",
    "typescript": "^5.7.0"
  }
}
